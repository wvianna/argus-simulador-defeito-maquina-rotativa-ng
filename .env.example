# Copie para .env e ajuste os valores conforme necessário (nunca versionar .env real)

# Conexão com o banco de dados (usada por backend e alembic)
DATABASE_URL=postgresql+asyncpg://argus:argus@db:5432/argus

# Postgres (usado pelo serviço db do docker-compose)
POSTGRES_USER=argus
POSTGRES_PASSWORD=argus
POSTGRES_DB=argus

# Tolerâncias do Paralelepípedo de Descarte e desvio de rotação (FR-007, FR-008)
ARGUS_DESVIO_ROTACAO=5.0
ARGUS_DELTA_FREQUENCIA_HZ=0.5
ARGUS_DELTA_AMPLITUDE=0.1
ARGUS_DELTA_FASE_GRAUS=15.0

# Front-end: prefixo usado pelo client HTTP (nginx/Vite encaminham /api para o back-end)
VITE_API_BASE_URL=/api
