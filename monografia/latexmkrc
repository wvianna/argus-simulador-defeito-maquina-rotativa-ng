# latexmkrc — documentação da compilação (latexmk não instalado no ambiente)
# Compilação equivalente (executar na pasta monografia/):
#   pdflatex -interaction=nonstopmode -halt-on-error main.tex
#   bibtex main
#   pdflatex -interaction=nonstopmode -halt-on-error main.tex
#   pdflatex -interaction=nonstopmode -halt-on-error main.tex
#
# Se latexmk estiver disponível, usar:
#   latexmk -pdf -interaction=nonstopmode -halt-on-error main.tex

$pdf_mode = 1;          # pdflatex
$bibtex_use = 1;        # usar bibtex
$bibtex_mode = 1;
$max_repeat = 5;
